  "items": [
   {
    "text": "In 1987, Earth felt",
    "start": 19,
    "end": 120
   },
   {
    "text": "a star explode,",
    "start": 120,
    "end": 207
   },
   {
    "text": "hours before",
    "start": 217,
    "end": 260
   },
   {
    "text": "anyone saw it.",
    "start": 260,
    "end": 316
   },
   {
    "text": "It burned hydrogen",
    "start": 322,
    "end": 393
   },
   {
    "text": "for ~10 million years,",
    "start": 393,
    "end": 487
   },
   {
    "text": "and silicon for only",
    "start": 500,
    "end": 574
   },
   {
    "text": "about 2 weeks,",
    "start": 574,
    "end": 635
   },
   {
    "text": "down to an iron core",
    "start": 647,
    "end": 715
   },
   {
    "text": "the size of Earth.",
    "start": 715,
    "end": 784
   },
   {
    "text": "Iron can't burn.",
    "start": 841,
    "end": 921
   },
   {
    "text": "In under a second,",
    "start": 944,
    "end": 999
   },
   {
    "text": "the core collapsed",
    "start": 999,
    "end": 1053
   },
   {
    "text": "to the size of a city,",
    "start": 1053,
    "end": 1127
   },
   {
    "text": "and fired out",
    "start": 1135,
    "end": 1180
   },
   {
    "text": "ten to the fifty-eight",
    "start": 1180,
    "end": 1254
   },
   {
    "text": "neutrinos.",
    "start": 1254,
    "end": 1297
   },
   {
    "text": "They flew straight",
    "start": 1351,
    "end": 1401
   },
   {
    "text": "through the star.",
    "start": 1401,
    "end": 1455
   },
   {
    "text": "The shockwave took",
    "start": 1470,
    "end": 1528
   },
   {
    "text": "about 2 hours",
    "start": 1528,
    "end": 1570
   },
   {
    "text": "to reach the surface.",
    "start": 1570,
    "end": 1644
   },
   {
    "text": "168,000 years later,",
    "start": 1747,
    "end": 1904
   },
   {
    "text": "they came up through",
    "start": 1905,
    "end": 1997
   },
   {
    "text": "over 4,000 km of rock,",
    "start": 1997,
    "end": 2105
   },
   {
    "text": "into a water tank",
    "start": 2113,
    "end": 2177
   },
   {
    "text": "in Japan.",
    "start": 2177,
    "end": 2220
   },
   {
    "text": "It caught 12.",
    "start": 2246,
    "end": 2315
   },
   {
    "text": "Hours later",
    "start": 2347,
    "end": 2384
   },
   {
    "text": "came the light:",
    "start": 2384,
    "end": 2441
   },
   {
    "text": "the first naked-eye",
    "start": 2457,
    "end": 2552
   },
   {
    "text": "supernova since 1604.",
    "start": 2552,
    "end": 2664
   },
   {
    "text": "Then its debris",
    "start": 2685,
    "end": 2746
   },
   {
    "text": "hit a ring the star",
    "start": 2746,
    "end": 2823
   },
   {
    "text": "had shed 20,000",
    "start": 2823,
    "end": 2885
   },
   {
    "text": "years before.",
    "start": 2885,
    "end": 2946
   },
   {
    "text": "In 2024, Webb found",
    "start": 2953,
    "end": 3047
   },
   {
    "text": "its likely heart:",
    "start": 3047,
    "end": 3138
   },
   {
    "text": "a neutron star,",
    "start": 3153,
    "end": 3228
   },
   {
    "text": "hidden in the dust.",
    "start": 3228,
    "end": 3299
   },
   {
    "text": "The one whose neutrinos",
    "start": 3318,
    "end": 3392
   },
   {
    "text": "got here first.",
    "start": 3392,
    "end": 3449
   }
  ]
