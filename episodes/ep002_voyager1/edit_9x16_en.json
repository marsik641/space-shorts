  "items": [
   {
    "text": "Nov 18:",
    "start": 19,
    "end": 93
   },
   {
    "text": "the first machine",
    "start": 106,
    "end": 158
   },
   {
    "text": "ever to be a light-day",
    "start": 158,
    "end": 225
   },
   {
    "text": "from Earth.",
    "start": 225,
    "end": 267
   },
   {
    "text": "Look back.",
    "start": 316,
    "end": 352
   },
   {
    "text": "The Sun is just a star,",
    "start": 352,
    "end": 439
   },
   {
    "text": "right below Orion.",
    "start": 443,
    "end": 511
   },
   {
    "text": "And Earth?",
    "start": 610,
    "end": 644
   },
   {
    "text": "Lost in the glare.",
    "start": 644,
    "end": 709
   },
   {
    "text": "The Sun outshines",
    "start": 723,
    "end": 788
   },
   {
    "text": "10 full Moons.",
    "start": 788,
    "end": 849
   },
   {
    "text": "A signal from Earth",
    "start": 907,
    "end": 971
   },
   {
    "text": "reaches the Sun",
    "start": 971,
    "end": 1023
   },
   {
    "text": "in 8 minutes.",
    "start": 1023,
    "end": 1075
   },
   {
    "text": "Jupiter, 43 min.",
    "start": 1091,
    "end": 1181
   },
   {
    "text": "Saturn, over an hour.",
    "start": 1184,
    "end": 1270
   },
   {
    "text": "Neptune, 4 hours.",
    "start": 1285,
    "end": 1381
   },
   {
    "text": "Voyager 1: soon,",
    "start": 1435,
    "end": 1494
   },
   {
    "text": "a full light-day.",
    "start": 1495,
    "end": 1579
   },
   {
    "text": "49 years after launch.",
    "start": 1609,
    "end": 1722
   },
   {
    "text": "Saturn's gravity",
    "start": 1762,
    "end": 1821
   },
   {
    "text": "bent its path north,",
    "start": 1821,
    "end": 1901
   },
   {
    "text": "out of the plane",
    "start": 1911,
    "end": 1953
   },
   {
    "text": "of the planets.",
    "start": 1953,
    "end": 2000
   },
   {
    "text": "2012:",
    "start": 2083,
    "end": 2140
   },
   {
    "text": "it left the Sun's bubble.",
    "start": 2140,
    "end": 2219
   },
   {
    "text": "Nuclear-powered,",
    "start": 2263,
    "end": 2328
   },
   {
    "text": "yet it calls home",
    "start": 2331,
    "end": 2396
   },
   {
    "text": "with about 23 watts:",
    "start": 2396,
    "end": 2480
   },
   {
    "text": "a fridge light bulb.",
    "start": 2493,
    "end": 2567
   },
   {
    "text": "All 6 computers together",
    "start": 2614,
    "end": 2711
   },
   {
    "text": "hold about 68 kilobytes.",
    "start": 2711,
    "end": 2816
   },
   {
    "text": "Bolted to its side:",
    "start": 2831,
    "end": 2916
   },
   {
    "text": "the Golden Record.",
    "start": 2924,
    "end": 2989
   },
   {
    "text": "In about 40,000 years,",
    "start": 3073,
    "end": 3183
   },
   {
    "text": "it'll drift within",
    "start": 3184,
    "end": 3246
   },
   {
    "text": "2 light-years",
    "start": 3246,
    "end": 3291
   },
   {
    "text": "of a small red star.",
    "start": 3291,
    "end": 3367
   },
   {
    "text": "But first, mark the date.",
    "start": 3389,
    "end": 3489
   }
  ]
