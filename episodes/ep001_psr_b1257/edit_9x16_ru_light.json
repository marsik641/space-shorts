  "items": [
   {
    "text": "Эта мёртвая звезда делает",
    "start": 19,
    "end": 137
   },
   {
    "text": "161 оборот в секунду.",
    "start": 137,
    "end": 245
   },
   {
    "text": "Это пульсар —",
    "start": 274,
    "end": 333
   },
   {
    "text": "сжавшееся ядро",
    "start": 333,
    "end": 396
   },
   {
    "text": "гигантской звезды.",
    "start": 396,
    "end": 476
   },
   {
    "text": "Тяжелее Солнца,",
    "start": 476,
    "end": 543
   },
   {
    "text": "но всего 20 км",
    "start": 543,
    "end": 606
   },
   {
    "text": "в поперечнике.",
    "start": 606,
    "end": 676
   },
   {
    "text": "Из магнитных полюсов бьют",
    "start": 685,
    "end": 768
   },
   {
    "text": "лучи радиоизлучения и,",
    "start": 768,
    "end": 850
   },
   {
    "text": "как маяк,",
    "start": 856,
    "end": 898
   },
   {
    "text": "прочёсывают пространство.",
    "start": 901,
    "end": 988
   },
   {
    "text": "В 1992 году",
    "start": 997,
    "end": 1047
   },
   {
    "text": "вокруг него нашли то,",
    "start": 1047,
    "end": 1138
   },
   {
    "text": "чего никто не ждал, —",
    "start": 1138,
    "end": 1230
   },
   {
    "text": "планеты.",
    "start": 1230,
    "end": 1274
   },
   {
    "text": "Первые подтверждённые планеты",
    "start": 1339,
    "end": 1437
   },
   {
    "text": "за пределами",
    "start": 1437,
    "end": 1475
   },
   {
    "text": "Солнечной системы.",
    "start": 1475,
    "end": 1557
   },
   {
    "text": "Вероятно,",
    "start": 1705,
    "end": 1756
   },
   {
    "text": "они родились",
    "start": 1756,
    "end": 1791
   },
   {
    "text": "из диска обломков — возможно,",
    "start": 1791,
    "end": 1903
   },
   {
    "text": "от разрушенной звезды-соседки.",
    "start": 1903,
    "end": 2003
   },
   {
    "text": "Излучение и ветер",
    "start": 2017,
    "end": 2090
   },
   {
    "text": "частиц пульсара",
    "start": 2090,
    "end": 2147
   },
   {
    "text": "бьют по ним",
    "start": 2147,
    "end": 2182
   },
   {
    "text": "без остановки — и, возможно,",
    "start": 2182,
    "end": 2299
   },
   {
    "text": "зажигают в их небе сияния.",
    "start": 2299,
    "end": 2419
   },
   {
    "text": "Драугр. Полтергейст. Фобетор.",
    "start": 2665,
    "end": 2930
   },
   {
    "text": "Миры с именами нежити",
    "start": 2976,
    "end": 3061
   },
   {
    "text": "и кошмаров",
    "start": 3061,
    "end": 3101
   },
   {
    "text": "вокруг звезды",
    "start": 3101,
    "end": 3152
   },
   {
    "text": "по имени Лич.",
    "start": 3152,
    "end": 3215
   },
   {
    "text": "А такие пульсары",
    "start": 3259,
    "end": 3322
   },
   {
    "text": "отмеряют время",
    "start": 3322,
    "end": 3373
   },
   {
    "text": "почти как атомные часы.",
    "start": 3373,
    "end": 3484
   }
  ]
 },
