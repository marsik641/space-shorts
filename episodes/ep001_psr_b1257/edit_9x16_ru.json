  "items": [
   {
    "text": "Эта мёртвая звезда",
    "start": 17,
    "end": 87
   },
   {
    "text": "делает сто шестьдесят",
    "start": 87,
    "end": 154
   },
   {
    "text": "один оборот в секунду.",
    "start": 154,
    "end": 236
   },
   {
    "text": "Это пульсар —",
    "start": 274,
    "end": 325
   },
   {
    "text": "сжавшееся ядро",
    "start": 325,
    "end": 380
   },
   {
    "text": "гигантской звезды.",
    "start": 380,
    "end": 449
   },
   {
    "text": "Тяжелее Солнца,",
    "start": 449,
    "end": 508
   },
   {
    "text": "но всего двадцать",
    "start": 508,
    "end": 574
   },
   {
    "text": "километров в поперечнике.",
    "start": 574,
    "end": 676
   },
   {
    "text": "Из магнитных полюсов",
    "start": 684,
    "end": 751
   },
   {
    "text": "бьют лучи",
    "start": 751,
    "end": 785
   },
   {
    "text": "радиоизлучения и,",
    "start": 785,
    "end": 850
   },
   {
    "text": "как маяк,",
    "start": 856,
    "end": 898
   },
   {
    "text": "прочёсывают пространство.",
    "start": 901,
    "end": 988
   },
   {
    "text": "В девяносто втором",
    "start": 997,
    "end": 1064
   },
   {
    "text": "году вокруг него нашли",
    "start": 1064,
    "end": 1144
   },
   {
    "text": "то, чего никто не",
    "start": 1144,
    "end": 1208
   },
   {
    "text": "ждал, — планеты.",
    "start": 1208,
    "end": 1274
   },
   {
    "text": "Первые подтверждённые",
    "start": 1337,
    "end": 1409
   },
   {
    "text": "планеты за пределами",
    "start": 1409,
    "end": 1475
   },
   {
    "text": "Солнечной системы.",
    "start": 1475,
    "end": 1557
   },
   {
    "text": "Вероятно, они родились",
    "start": 1705,
    "end": 1786
   },
   {
    "text": "из диска обломков —",
    "start": 1786,
    "end": 1857
   },
   {
    "text": "возможно, от",
    "start": 1857,
    "end": 1903
   },
   {
    "text": "разрушенной звезды-соседки.",
    "start": 1903,
    "end": 2009
   },
   {
    "text": "Излучение и ветер",
    "start": 2017,
    "end": 2087
   },
   {
    "text": "частиц пульсара бьют",
    "start": 2087,
    "end": 2168
   },
   {
    "text": "по ним без остановки",
    "start": 2168,
    "end": 2250
   },
   {
    "text": "— и,",
    "start": 2250,
    "end": 2269
   },
   {
    "text": "возможно, зажигают в",
    "start": 2269,
    "end": 2350
   },
   {
    "text": "их небе сияния.",
    "start": 2350,
    "end": 2420
   },
   {
    "text": "Драугр. Полтергейст.",
    "start": 2658,
    "end": 2828
   },
   {
    "text": "Фобетор. Миры с",
    "start": 2872,
    "end": 3008
   },
   {
    "text": "именами нежити и",
    "start": 3008,
    "end": 3065
   },
   {
    "text": "кошмаров вокруг звезды",
    "start": 3065,
    "end": 3152
   },
   {
    "text": "по имени Лич.",
    "start": 3152,
    "end": 3215
   },
   {
    "text": "А такие пульсары",
    "start": 3257,
    "end": 3322
   },
   {
    "text": "отмеряют время почти",
    "start": 3322,
    "end": 3398
   },
   {
    "text": "как атомные часы.",
    "start": 3398,
    "end": 3484
   }
  ]
 },
