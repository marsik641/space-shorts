  "items": [
   {
    "text": "Эта мёртвая звезда",
    "start": 17,
    "end": 87
   },
   {
    "text": "делает сто шестьдесят",
    "start": 87,
    "end": 154
   },
   {
    "text": "один оборот в секунду.",
    "start": 154,
    "end": 236
   },
   {
    "text": "Это пульсар —",
    "start": 274,
    "end": 325
   },
   {
    "text": "сжавшееся ядро",
    "start": 325,
    "end": 380
   },
   {
    "text": "гигантской звезды.",
    "start": 380,
    "end": 449
   },
   {
    "text": "Тяжелее Солнца,",
    "start": 449,
    "end": 508
   },
   {
    "text": "но всего двадцать",
    "start": 508,
    "end": 574
   },
   {
    "text": "километров в поперечнике.",
    "start": 574,
    "end": 676
   },
   {
    "text": "Из магнитных полюсов",
    "start": 684,
    "end": 756
   },
   {
    "text": "бьют лучи",
    "start": 756,
    "end": 789
   },
   {
    "text": "радиоизлучения и,",
    "start": 789,
    "end": 857
   },
   {
    "text": "как маяк,",
    "start": 865,
    "end": 910
   },
   {
    "text": "метут пространство.",
    "start": 910,
    "end": 984
   },
   {
    "text": "В девяносто втором",
    "start": 997,
    "end": 1064
   },
   {
    "text": "году вокруг него нашли",
    "start": 1064,
    "end": 1144
   },
   {
    "text": "то, чего никто не",
    "start": 1144,
    "end": 1208
   },
   {
    "text": "ждал, — планеты.",
    "start": 1208,
    "end": 1274
   },
   {
    "text": "Первые подтверждённые",
    "start": 1337,
    "end": 1409
   },
   {
    "text": "планеты за пределами",
    "start": 1409,
    "end": 1475
   },
   {
    "text": "Солнечной системы.",
    "start": 1475,
    "end": 1557
   },
   {
    "text": "Скорее всего,",
    "start": 1703,
    "end": 1765
   },
   {
    "text": "они родились из",
    "start": 1767,
    "end": 1815
   },
   {
    "text": "обломков, оставшихся",
    "start": 1815,
    "end": 1900
   },
   {
    "text": "после гибели звезды.",
    "start": 1900,
    "end": 1976
   },
   {
    "text": "Излучение и ветер",
    "start": 2017,
    "end": 2083
   },
   {
    "text": "частиц пульсара бьют",
    "start": 2083,
    "end": 2160
   },
   {
    "text": "по ним без остановки",
    "start": 2160,
    "end": 2238
   },
   {
    "text": "— и,",
    "start": 2238,
    "end": 2256
   },
   {
    "text": "вероятно, зажигают",
    "start": 2256,
    "end": 2326
   },
   {
    "text": "сияния на ночной стороне.",
    "start": 2326,
    "end": 2429
   },
   {
    "text": "Драугр. Полтергейст.",
    "start": 2658,
    "end": 2828
   },
   {
    "text": "Фобетор. Миры с",
    "start": 2872,
    "end": 3008
   },
   {
    "text": "именами призраков и",
    "start": 3008,
    "end": 3076
   },
   {
    "text": "чудовищ вокруг звезды",
    "start": 3076,
    "end": 3151
   },
   {
    "text": "по имени Лич.",
    "start": 3151,
    "end": 3214
   },
   {
    "text": "А её пульс отмеряет",
    "start": 3257,
    "end": 3334
   },
   {
    "text": "время почти как",
    "start": 3334,
    "end": 3396
   },
   {
    "text": "атомные часы.",
    "start": 3396,
    "end": 3463
   }
  ]
 },
